/* ============================================================
   RBX Market - Main Stylesheet
   โทนสี: ม่วง-น้ำเงินเข้ม (Dark) ตัดด้วยส้ม/เหลืองทอง (Accent)
   ============================================================ */
:root {
    --bg-dark: #0f0b1e;
    --bg-darker: #0a0714;
    --surface: #191330;
    --surface-light: #241c42;
    --border-color: #322b52;
    --primary: #7b3fe4;
    --primary-light: #9b6bff;
    --primary-dark: #5a2bc7;
    --accent: #ffb020;
    --accent-light: #ffc94d;
    --text-main: #f1edfa;
    --text-muted: #a89fc9;
    --success: #2ecc71;
    --danger: #ff5470;
    --warning: #ffb020;
    --radius: 14px;
    --shadow: 0 8px 24px rgba(0,0,0,0.35);
}

* { box-sizing: border-box; }

body {
    background: linear-gradient(160deg, var(--bg-dark) 0%, var(--bg-darker) 100%);
    color: var(--text-main);
    font-family: 'Kanit', 'Segoe UI', sans-serif;
    min-height: 100vh;
    margin: 0;
}

a { text-decoration: none; color: inherit; }

/* ---------------- Navbar ---------------- */
.navbar-custom {
    background: rgba(15, 11, 30, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    padding: 14px 0;
    position: sticky;
    top: 0;
    z-index: 100;
}
.navbar-custom .navbar-brand {
    font-weight: 700;
    font-size: 1.5rem;
    background: linear-gradient(90deg, var(--primary-light), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.navbar-custom .nav-link {
    color: var(--text-muted) !important;
    font-weight: 500;
    padding: 8px 16px !important;
    border-radius: 8px;
    transition: all 0.2s;
}
.navbar-custom .nav-link:hover,
.navbar-custom .nav-link.active {
    color: var(--text-main) !important;
    background: var(--surface-light);
}
.wallet-badge {
    background: linear-gradient(90deg, var(--accent), var(--accent-light));
    color: #241800;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 30px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

/* ---------------- Hero ---------------- */
.hero-section {
    background: radial-gradient(circle at top right, rgba(123,63,228,0.35), transparent 60%),
                radial-gradient(circle at bottom left, rgba(255,176,32,0.15), transparent 50%);
    padding: 70px 0 50px;
    text-align: center;
}
.hero-section h1 {
    font-size: 2.6rem;
    font-weight: 800;
    margin-bottom: 12px;
}
.hero-section h1 span {
    background: linear-gradient(90deg, var(--primary-light), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.hero-section p { color: var(--text-muted); font-size: 1.1rem; }

/* ---------------- Cards ---------------- */
.card-custom {
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius  box-shadow: var(--shadow);
    transition: transform 0.25s, border-color 0.25s;
    overflow: hidden;
    height: 100%;
}
.card-custom:hover {
    transform: translateY(-6px);
    border-color: var(--primary);
}
.card-img-wrap {
    height: 160px;
    background: linear-gradient(135deg, var(--surface-light), var(--bg-darker));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    overflow: hidden;
}
.card-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.card-custom .card-body { padding: 18px; }
.card-custom .card-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 6px; }
.card-custom .price-tag {
    color: var(--accent);
    font-weight: 800;
    font-size: 1.2rem;
}
.badge-shop {
    background: var(--surface-light);
    color: var(--primary-light);
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 8px;
}

/* ---------------- Filter bar ---------------- */
.filter-bar {
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 18px;
    margin-bottom: 28px;
}
.filter-bar select, .filter-bar input {
    background: var(--bg-darker);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    border-radius: 8px;
}
.filter-bar select:focus, .filter-bar input:focus {
    background: var(--bg-darker);
    color: var(--text-main);
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(123,63,228,0.25);
}

/* ---------------- Buttons ---------------- */
.btn-primary-custom {
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
    border: none;
    color: #fff;
    font-weight: 600;
    padding: 10px 24px;
    border-radius: 10px;
    transition: filter 0.2s;
}
.btn-primary-custom:hover { filter: brightness(1.15); color: #fff; }
.btn-accent-custom {
    background: linear-gradient(90deg, var(--accent), var(--accent-light));
    border: none;
    color: #241800;
    font-weight: 700;
    padding: 10px 24px;
    border-radius: 10px;
}
.btn-accent-custom:hover { filter: brightness(1.1); color: #241800; }
.btn-outline-custom {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    border-radius: 10px;
}
.btn-outline-custom:hover { background: var(--surface-light); color: var(--text-main); }

/* ---------------- Auth forms ---------------- */
.auth-wrapper {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
}
.auth-box {
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 40px;
    width: 100%;
    max-width: 420px;
    box-shadow: var(--shadow);
}
.auth-box h3 { font-weight: 700; margin-bottom: 6px; }
.auth-box .form-control {
    background: var(--bg-darker);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 12px 14px;
    border-radius: 10px;
    margin-bottom: 14px;
}
.auth-box .form-control:focus {
    background: var(--bg-darker);
    color: var(--text-main);
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(123,63,228,0.25);
}

/* ---------------- Tables (admin) ---------------- */
.table-custom {
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--text-main);
}
.table-custom th {
    background: var(--surface-light);
    color: var(--text-muted);
    font-weight: 600;
    border-color: var(--border-color);
}
.table-custom td { border-color: var(--border-color); vertical-align: middle; }

/* ---------------- Sidebar (admin) ---------------- */
.admin-sidebar {
    background: var(--bg-darker);
    min-height: 100vh;
    border-right: 1px solid var(--border-color);
    padding: 20px 0;
}
.admin-sidebar .nav-link {
    color: var(--text-muted);
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
}
.admin-sidebar .nav-link:hover,
.admin-sidebar .nav-link.active {
    background: var(--surface-light);
    color: var(--accent);
    border-right: 3px solid var(--accent);
}
.admin-stat-card {
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 22px;
}
.admin-stat-card .stat-num { font-size: 1.8rem; font-weight: 800; color: var(--accent); }
.admin-stat-card .stat-label { color: var(--text-muted); font-size: 0.9rem; }

/* ---------------- Misc ---------------- */
.section-title {
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 20px;
    border-left: 4px solid var(--accent);
    padding-left: 12px;
}
.status-badge { padding: 5px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }
.status-pending { background: rgba(255,176,32,0.2); color: var(--accent); }
.status-approved, .status-completed, .status-active { background: rgba(46,204,113,0.2); color: var(--success); }
.status-rejected, .status-cancelled, .status-banned { background: rgba(255,84,112,0.2); color: var(--danger); }
.status-sold { background: rgba(160,160,160,0.2); color: #aaa; }

.footer-custom {
    background: var(--bg-darker);
    border-top: 1px solid var(--border-color);
    padding: 26px 0;
    text-align: center;
    color: var(--text-muted);
    margin-top: 60px;
}

.slip-preview img { max-width: 100%; border-radius: 10px; border: 1px solid var(--border-color); }

.empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); }
.empty-state .icon { font-size: 3rem; margin-bottom: 12px; }
